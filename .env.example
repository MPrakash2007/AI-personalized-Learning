# ==============================================================================
# CodeOrbit — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in your Vercel Project Settings (Project -> Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required for Vercel Production)
# ------------------------------------------------------------------------------
# In production on Vercel, Serverless Functions cannot persist to SQLite disk.
# Provide a managed PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
# If left empty in local development, CodeOrbit defaults to local SQLite (backend/codeorbit.db).
DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required for Production)
# ------------------------------------------------------------------------------
# Secret key used to sign JWT authentication tokens. Generate a strong random key:
# openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_generate_random_32_chars_or_more

# ------------------------------------------------------------------------------
# 3. CORS & ORIGIN CONTROL
# ------------------------------------------------------------------------------
# Comma-separated list of extra allowed client origins.
# Note: Vercel preview domains (*.vercel.app) and localhost are automatically handled.
CORS_ORIGINS=https://my-codeorbit.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. AI TUTOR ENGINE (OpenAI Integration)
# ------------------------------------------------------------------------------
# Official OpenAI Python SDK integration for general-purpose educational AI tutoring.
# In production on Vercel: Set OPENAI_API_KEY in Vercel Project Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Legacy/Local AI Providers (Optional):
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Local Development Only)
# ------------------------------------------------------------------------------
# On Vercel, the frontend automatically communicates with /api on the same domain.
# For local dev without Vite proxy, you can optionally set:
# VITE_API_URL=http://127.0.0.1:8000
